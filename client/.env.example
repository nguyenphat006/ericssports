# Base API URL của Django Backend Server (Port 8000, version 1)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Nguồn dữ liệu storefront: "mock" (dữ liệu mẫu, GĐ1–3) | "api" (Django, từ GĐ4)
NEXT_PUBLIC_DATA_SOURCE=mock

# URL công khai của website (canonical, Open Graph). Production: https://ericssports.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000
